// =====================================================
// PANEL CONFIGURATION
// =====================================================

static const int PANEL_WIDTH  = 64;
static const int PANEL_HEIGHT = 64;
static const int PANEL_CHAIN  = 1;

#define PIN_R1   25
#define PIN_G1   26
#define PIN_B1   27
#define PIN_R2   14
#define PIN_G2   12
#define PIN_B2   13
#define PIN_A    23
#define PIN_B    19
#define PIN_C     5
#define PIN_D    17
#define PIN_E    32
#define PIN_LAT   4
#define PIN_OE   15
#define PIN_CLK  16

MatrixPanel_I2S_DMA* display = nullptr;
uint16_t palette[10];

// Confirmed physical order for this panel: GBR.
static inline uint16_t panelColor(uint8_t r, uint8_t g, uint8_t b) {
  return display->color565(g, b, r);
}

void buildPalette() {
  palette[0] = panelColor(0, 0, 0);         // black/background
  palette[1] = panelColor(255, 220, 0);     // yellow
  palette[2] = panelColor(35, 12, 0);       // dark outline
  palette[3] = panelColor(255, 0, 0);       // red
  palette[4] = panelColor(0, 255, 0);       // green
  palette[5] = panelColor(0, 0, 255);       // blue
  palette[6] = panelColor(255, 255, 255);   // white
  palette[7] = panelColor(255, 0, 255);     // magenta
  palette[8] = panelColor(0, 255, 255);     // cyan
  palette[9] = panelColor(255, 110, 0);     // orange
}

void drawBitmap64() {
  for (int y = 0; y < PANEL_HEIGHT; y++) {
    for (int x = 0; x < PANEL_WIDTH; x++) {
      const uint8_t index = pgm_read_byte(&faceBitmap64[y * 64 + x]);
      display->drawPixel(x, y, palette[index]);
    }
  }
}

void setupDisplay() {
  HUB75_I2S_CFG::i2s_pins pins = {
    PIN_R1, PIN_G1, PIN_B1,
    PIN_R2, PIN_G2, PIN_B2,
    PIN_A, PIN_B, PIN_C, PIN_D, PIN_E,
    PIN_LAT, PIN_OE, PIN_CLK
  };

  HUB75_I2S_CFG config(
    PANEL_WIDTH,
    PANEL_HEIGHT,
    PANEL_CHAIN,
    pins
  );

  // Known-working configuration for this AliExpress Clockwise clone:
  // ESP32 Arduino Core 2.0.17 + older HUB75 DMA library.
  config.driver = HUB75_I2S_CFG::FM6126A;
  config.clkphase = true;
  config.double_buff = false;

  display = new MatrixPanel_I2S_DMA(config);

  if (!display->begin()) {
    Serial.println("ERROR: matrix initialization failed.");
    while (true) {
      delay(1000);
    }
  }

  display->setBrightness8(40);
  display->clearScreen();
}

void setup() {
  Serial.begin(115200);
  delay(500);

  setupDisplay();
  buildPalette();
  drawBitmap64();

  Serial.println("64x64 bitmap drawn.");
  Serial.printf("Refresh: %d Hz\n", display->calculated_refresh_rate);
}

void loop() {
  // Static full-screen bitmap. Nothing needs to be redrawn.
}
